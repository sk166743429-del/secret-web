<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carding Secret Web</title>
  <style>
    body { background: #0b0b14; color: #fff; font-family: sans-serif; padding: 15px; margin: 0; }
    .banner-edit-fixed { position: relative; width: 100%; margin-bottom: 15px; }
    .banner-container { width: 100%; border-radius: 15px; overflow: hidden; }
    .banner-container img { width: 100%; height: auto; display: block; border-radius: 15px; }
    .edit-btn { position: absolute; top: 10px; right: 10px; background: #f59e0b; color: #000; padding: 4px 12px; border-radius: 6px; font-size: 12px; font-weight: bold; text-decoration: none; box-shadow: 0 2px 6px rgba(0,0,0,0.6); z-index: 10; }
  </style>
</head>
<body>
  <h2>CARDING SECRET WEB</h2>
  
  <div class="banner-edit-fixed">
    <div class="banner-container">
      <a href="<%= typeof bannerLink !== 'undefined' ? bannerLink : '#' %>" target="_blank">
        <img src="/banner.png" alt="Banner">
      </a>
    </div>
    <a href="#" onclick="document.getElementById('bannerEditModal').style.display='block'; return false;" class="edit-btn">✏️ Edit</a>
  </div>

  <!-- Edit Modal -->
  <div id="bannerEditModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:9999; padding:20px; box-sizing:border-box;">
    <div style="background:#12121c; max-width:400px; margin:60px auto; padding:20px; border-radius:12px; border:2px solid #7928ca; color:#fff;">
      <h3 style="color:#7928ca; margin-bottom:15px; text-align:center;">Edit Banner & Link</h3>
      <form action="/admin/update-dash-photo" method="POST" enctype="multipart/form-data">
        <label style="display:block; margin-bottom:5px; font-size:14px; font-weight:bold;">Select Photo from Gallery:</label>
        <input type="file" name="bannerImage" accept="image/*" style="width:100%; padding:8px; background:#1a1a2e; color:#fff; border:1px solid #444; border-radius:6px; margin-bottom:12px;"><br>
        
        <label style="display:block; margin-bottom:5px; font-size:14px; font-weight:bold;">Redirect Link:</label>
        <input type="text" name="bannerLink" placeholder="https://t.me/your_channel" style="width:100%; padding:8px; background:#1a1a2e; color:#fff; border:1px solid #444; border-radius:6px; margin-bottom:15px;"><br>
        
        <button type="submit" style="width:100%; background:#7928ca; color:#fff; padding:10px; border:none; border-radius:6px; font-weight:bold; cursor:pointer;">Save Changes</button>
      </form>
      <button onclick="document.getElementById('bannerEditModal').style.display='none'" style="width:100%; background:#444; color:#fff; padding:8px; border:none; border-radius:6px; margin-top:10px; cursor:pointer;">Cancel</button>
    </div>
  </div>
</body>
</html>
